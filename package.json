{
  "name": "mitchdesigns-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "bash .claude/dev.sh",
    "dev:raw": "next dev --turbopack",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lead": "node scripts/test-lead.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.20.12",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@userback/widget": "^0.3.12",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "^16.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.151.1"
  }
}
